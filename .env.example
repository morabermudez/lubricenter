# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public (HTTPS) URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, the Mercado Pago back_urls,
# and as the base of the webhook notification_url (POST /webhook).
APP_URL="MY_APP_URL"

# Supabase: required for appointments and inventory.
# Use the Project URL and anon/public key from your Supabase project settings.
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_KEY="YOUR_SUPABASE_ANON_KEY"

# Mercado Pago: required for payment preferences (server-side access token)
# and for the client-side SDK (public key).
MERCADOPAGO_ACCESS_TOKEN="YOUR_MERCADOPAGO_ACCESS_TOKEN"
VITE_MERCADOPAGO_PUBLIC_KEY="YOUR_MERCADOPAGO_PUBLIC_KEY"

# Expiration dates (ISO YYYY-MM-DD) shown as ≤30-day alerts in the Boss dashboard.
# Update these when regenerating the Mercado Pago token or renewing the hosting.
MERCADOPAGO_TOKEN_EXPIRES="2026-12-31"
DEPLOY_EXPIRES="2026-12-31"
DEPLOY_URL="https://your-hosting-console.example.com"
